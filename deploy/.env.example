# Copy to deploy/.env before the first `docker compose up`.
#
# Compose reads .env from the directory of the compose file, and it reads it
# for every command — including `down`. Exporting these in your shell works
# once; putting them here means the person who has to stop the service at
# three in the morning does not have to know what the origin was.

# Required. The public address SDKs will send events to, and the only source
# for the DSNs the panel shows. It cannot be inferred from inside a container:
# behind a proxy the request says loopback while the DSN must say the real
# domain, and a wrong value hands out DSNs that resolve nowhere.
TRAPLINE_ORIGIN=https://errors.example.com

# The hostname Caddy serves, used only with `--profile caddy`. It should be
# the host part of TRAPLINE_ORIGIN.
#TRAPLINE_DOMAIN=errors.example.com

# Where the container's port 9000 is published on the host, loopback only.
# Change it if something else already owns 9000.
#TRAPLINE_PORT=9000

# Comma-separated addresses or CIDR blocks whose X-Forwarded-For is believed.
# Empty means trust nothing, and behind a proxy that means every visitor is
# counted as the proxy. Set it to your proxy's address on the compose network.
#TRAPLINE_TRUSTED_PROXIES=

# Ingest requests per minute per client address. Default 48000.
#TRAPLINE_INGEST_IP_RATE_LIMIT=48000

# Login attempts per minute per client address. Default 10 — every attempt
# costs a 19 MiB Argon2id working set, and there is one admin.
#TRAPLINE_AUTH_RATE_LIMIT=10

# Logs the reason every envelope was accepted, limited or dropped. The answer
# to "why did my event not show up?", and noisy enough that it is off.
#TRAPLINE_DEBUG=1
