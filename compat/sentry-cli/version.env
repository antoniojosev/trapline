# The pinned sentry-cli. Both the recorder and the verifier read it, and the
# fixtures live in a directory named after it, so "which version is this
# compatibility claim about" has exactly one answer.
#
# Moving this number means re-recording: run scripts/sentry-cli.sh, which
# records whenever there are no fixtures for the pinned version, and read the
# diff. A fixture that changed is a protocol change somebody has to look at.
SENTRY_CLI_VERSION=2.57.0
